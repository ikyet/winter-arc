<?xml version="1.0" encoding="utf-8"?>
<!--
  No existe un bloque "Interfaz de..." para esta pantalla en el rango del reporte asignado a los
  agentes de extracción. Reconstruido a partir del único id real que usa ExerciseListActivity.java
  (containerEjercicios), con el mismo estilo oscuro que el resto de la app.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/containerEjercicios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp" />

</ScrollView>
