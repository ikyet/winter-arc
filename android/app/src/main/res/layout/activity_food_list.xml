<?xml version="1.0" encoding="utf-8"?>
<!--
  No existe un bloque "Interfaz de..." para esta pantalla en el rango del reporte asignado a los
  agentes de extracción. Reconstruido a partir de los IDs reales que usa FoodListActivity.java
  (tvTitulo, llAlimentos), con el mismo estilo oscuro que el resto de la app.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/llAlimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
